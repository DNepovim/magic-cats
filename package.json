{
  "name": "magic-cats",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "check": "turbo run check",
    "lint:check": "turbo run lint:check",
    "lint:fix": "turbo run lint:fix",
    "format:check": "turbo run format:check",
    "format:write": "turbo run format:write",
    "typecheck": "turbo run typecheck",
    "email:build": "node email/build.mjs",
    "db:start": "pnpm -F game db:start",
    "db:stop": "pnpm -F game db:stop",
    "db:restart": "pnpm -F game db:restart",
    "db:status": "pnpm -F game db:status",
    "db:reset": "pnpm -F game db:reset",
    "db:studio": "pnpm -F game db:studio"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "turbo", "@turbo/darwin-arm64"]
  }
}
