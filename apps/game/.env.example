# Copy to .env and fill in. `supabase start` (run from apps/game) also reads this
# file, so both the SvelteKit app and the local Supabase stack are configured here.
#
# Local dev values come from `supabase status`:
#   PUBLIC_SUPABASE_URL      <- API_URL          e.g. http://127.0.0.1:54321
#   PUBLIC_SUPABASE_ANON_KEY <- PUBLISHABLE_KEY  e.g. sb_publishable_…
#
# For cloud environments these two come from the Supabase dashboard
# (Project Settings -> API Keys) and are set as Vercel env vars per scope.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth, for local sign-in only. Fills the env(...) placeholders in
# supabase/config.toml. From Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth 2.0 Client IDs (Web application). That client's
# "Authorized redirect URIs" must contain, spelled exactly:
#
#   http://127.0.0.1:54321/auth/v1/callback
#
# (127.0.0.1, not localhost — Google matches the string literally, and that is
# the URI GoTrue sends.) Cloud projects configure Google in the dashboard
# instead, so these are never needed outside local dev.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
